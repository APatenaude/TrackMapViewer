# Build artifacts and deps - regenerated inside the image
node_modules
dist

# Tiles are generated by `vips dzsave` during the Docker build (from assets/*.jpg),
# so never copy host-generated tiles over them.
public/tiles

# VCS / local
.git
.gitignore
.gitattributes
*.log

# Private analytics override is mounted at runtime, never baked into the image.
analytics.json
public/analytics.json
analytics.example.json

# CI / deploy files that don't belong in the image.
.github
compose*.yml
